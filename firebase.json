{
  "hosting": {
    "site": "iicp-ks-culture-map",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/.git/**",
      "**/.fontcache/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "build_offline.py",
      "deploy_site.py",
      "README.md",
      "CNAME",
      "מפת התרבות - קריית שמונה.html",
      "מפת התרבות - קריית שמונה.zip"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
        ]
      }
    ],
    "cleanUrls": false
  }
}
